# Copy this file to ".env" (same folder) ONLY if you want to configure encryption through it.
# NEVER commit or share ".env", and never put real keys in this example file.
# Easiest: run `python main.py --generate-key` - the key is then stored in your home folder (~/.gait_project/keys/).

# Optional: use a key file in another place (for example a USB stick)
# GAIT_KEY_FILE=D:\keys\dataset.key

# Optional: use a password instead of a key file (used when new files are encrypted)
# GAIT_KEY_PASSWORD=choose-a-long-passphrase
